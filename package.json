{
  "name": "thegnd",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "prisma generate",
    "s3:setup": "tsx scripts/setup-bucket.ts",
    "railway:env": "tsx scripts/sync-railway-env.ts",
    "flags:sync": "node -e \"const{cpSync,mkdirSync}=require('fs');mkdirSync('public/flags',{recursive:true});cpSync('node_modules/flag-icons/flags/1x1','public/flags',{recursive:true});console.log('Flaggen synchronisiert')\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
