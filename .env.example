# ══════════════════════════════════════════════════════════════════
#  THEGND — Umgebungsvariablen
#  Schnellweg:  railway login && railway link && npm run railway:env
# ══════════════════════════════════════════════════════════════════

# ── Railway Postgres ─────────────────────────────────────────────
# Lokal: öffentlicher TCP-Proxy   (railway tcp-proxy create --port 5432 --service Postgres)
DATABASE_URL="postgresql://postgres:PASSWORT@xxx.proxy.rlwy.net:PORT/railway"
DIRECT_URL="postgresql://postgres:PASSWORT@xxx.proxy.rlwy.net:PORT/railway"
# Im Railway-Deployment stattdessen die interne Adresse (kein Proxy, kein Egress):
# DATABASE_URL="postgresql://postgres:PASSWORT@postgres.railway.internal:5432/railway"

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="THEGND"
AUTH_SECRET="openssl rand -base64 48"
ADMIN_EMAILS="admin@thegnd.net"

# ── Railway Bucket (S3-kompatibel) ───────────────────────────────
# Werte:  railway bucket credentials --bucket <name> --json
S3_ENDPOINT="https://t3.storageapi.dev"
S3_REGION="auto"
S3_BUCKET="mein-bucket-xxxxxx"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"        # Railway/Tigris nutzt virtual-host-Style
# Leer lassen! Railway Buckets sind privat — die App liefert Medien über /media aus.
# Nur setzen, wenn ein CDN mit öffentlichem Lesezugriff davorhängt:
S3_PUBLIC_URL=""
# Zusätzliche Origins für CORS beim Direkt-Upload (Komma-getrennt):
# S3_EXTRA_CORS_ORIGINS="https://thegnd.net,https://www.thegnd.net"

# ── Resend ───────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="THEGND <no-reply@thegnd.net>"
EMAIL_REPLY_TO="support@thegnd.net"

# ── Optional ─────────────────────────────────────────────────────
CRON_SECRET="random-string"

# ── Karten & Umkreissuche ────────────────────────────────────────────────────
# Kontaktadresse im User-Agent der Geocoding-Anfragen (Photon / Nominatim).
# Deren Nutzungsbedingungen verlangen eine erreichbare Adresse. Ohne Angabe
# wird SITE.email verwendet.
GEOCODING_CONTACT="support@thegnd.net"
